int SSA_test() {
    int a = 10;
    int x = 20;
    if x < 15 {
        x += 10;
    }
    return x;
}

int SSA_test2() {
    int a = 10;
    int x = 20;
    if x < 15 {
        x += 10;
    }  else {
        x = 200;
    }
    return x;
}

int SSA_test3() {
    int a = 10;
    if a < 5 {
        a += 5;
    } else if a < 2 {
        a *= 6;
    } else if a < 0 {
        a += 1000;
    } else {
        a /= 5;
    }
    return a;
}


int while4() {
    int a = 0;
    int x = 10;
    while a < 10 {
        a += 1;
    }
    return a + x;
}

int while5() {
    int a = 0;
    int x = 10;
    int c = 1234;
    while a < 10 {
        a += 1;
        x = x + c;
    }
    return a + x * c;
}



int stress_test() {
    int a = 2;
    int b = 0;
    int result = 0;

    // Testing list literal with mixed constants, variables, and expressions
    List<int> k = [1, a, 10 + 5, a * 3];

    // Outer loop
    while a < 50 {
        // 'step' is local to the outer loop. It needs a new temp every outer iteration.
        int step = 0;

        // Inner loop
        while b < 10 {
            // 3-way branch inside a nested loop
            if b < 3 {
                step = step + k[0];
            } else if b < 7 {
                step = step + k[1];
                result = result + 1;
            } else {
                step = step + k[2];
                a = a + 1;
            }
            b = b + 1;
        }

        // 2-way branch outside the inner loop
        if step > 15 {
            a = a + k[3];
        } else {
            a = a + 5;
            result = result - 1;
        }

        // Reset inner loop counter (tests back-edge PHI updating for 'b')
        b = 0;
    }

    return a + result;
}