Int32 both_reach(Int32 x) {
    Int32 result = 0;
    if x < 5 {
        result += 1;
    } else {
        result += 2;
    }
    return result;
}

Int32 if_returns(Int32 x) {
    Int32 result = 0;
    if x < 5 {
        return 99;
    } else {
        result += 2;
    }
    return result;
}

Int32 else_returns(Int32 x) {
    Int32 result = 0;
    if x < 5 {
        result += 1;
    } else {
        return 99;
    }
    return result;
}

Int32 both_return(Int32 x) {
    if x < 5 {
        return 1;
    } else {
        return 2;
    }
}

Int32 while_else_returns(Int32 x) {
    Int32 result = 0;
    while x < 10 {
        if x < 5 {
            result += 1;
        } else {
            return result;
        }
        x += 1;
    }
    return result;
}


generic enum Option<T> {
    Some(T),
    None,
}

generic struct Double<A, B> {
    A a;
    B b;
}

