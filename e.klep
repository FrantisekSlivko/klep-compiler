Int max(Uint a, Int8 b) {
    if (cast<Int32>(a) > cast<Int32>(b)) {
        return cast<Int32>(a);
    } else {
        return b;
    }
}


Uint cast_test(Int a) {
    Int64 b = a;
    return cast<Uint>(a);
}

