// MOVE for var declr and assignment
Uint cast_test(Int a) {
    Int64 b = a;
    Int16 c = a;
    return cast<Uint>(a);
}

void drop_test(Box<Int> a, Option<Array<Int64, 5>> b) {

}

Int add(Int a, Int b) {
    return a + b;
}

Int deref(Ref<Int> a, Ref<Ref<Ref<Int>>> b) {
    return a + b;
}

Void if_plus_while(Int n) {
    Int i = 0;
    if (n < 0) {
        n = -1 * n;
    }
    while (i < n) {
        i += 1;
    }

}

Int kv(Uint8 a, Int8 b) {
    Int c = 0;
    if (a > b) {
        c = a + 1;
    } else {
        c = b + 1;
    }
    return c + 1;
}



