}

Int add(Int a, Int b) {
    return a + b;
}

Int deref(Ref<Int> a, Ref<Ref<Ref<Int>>> b) {
    return a + b;
}

Void if_plus_while(Int n) {
    Int i = 0;
    if (n < 0) {
        n = -1 * n;
    }
    while (i < n) {
        i += 1;
    }

}

Int kv(Uint8 a, Int8 b) {
    Int c = 0;
    if (cast<Int16>(a) > b) {
        c = a + 1;
    } else {
        c = b + 1;
    }
    return c + 1;
}

struct A {
  Int32 a;
  List<Int32> b;
}
generic struct Tuple<A, B> {
  A a;
  B b;
}

enum Color {
  Red,
  Blue,
  Green,
  RGB(Uint8, Uint8, Uint8)
}
generic enum Option<T> {
  Some(T),
  None
}

Void struct_and_enum_constructors() {
    Color color1 = new Color::Red;
    Color color2 = new Color::RGB(10, 5+1, 3);

    Uint8 opt_val = 10;
    Option<Uint8> opt1 = new Option::Some(opt_val);
    Option<Uint8> opt2 = new Option<Uint8>::Some(opt_val+3);

    A a = new A { a=10, b=[1, 2, 3] };
    Tuple<Int32, Bool> tuple1 = new Tuple<Int32, Bool> { a=15, b=true };
    Tuple<Int32, Bool> tuple2 = new Tuple { a=15, b=true };
}



Void index_field_test() {
    List<Int> l = [1+2, 2, 3];
    Int len = l.len;
    Int second = l[1];
    List<List<Int>> l2 = [l];
    Int double_len = l2[0].len;
    l[2] = 5;
    l[0] += 1;
    Int i = 0;
    while i < 10 {
        i += 1;
    }
    Int ii = i * i;
}

Int stress_test() {
    Int a = 2;
    Int b = 0;
    Int result = 0;
    // Testing list literal with mixed constants, variables, and expressions
    List<Int> k = [1, a, 10 + 5, a * 3];
    // Outer loop
    while a < 50 {
        // 'step' is local to the outer loop. It needs a new temp every outer iteration.
        Int step = 0;
        // Inner loop
        while b < 10 {
            // 3-way branch inside a nested loop
            if b < 3 {
                step = step + k[0];
            } else if b < 7 {
                step = step + k[1];
                result = result + 1;
            } else {
                step = step + k[2];
                a = a + 1;
            }
            b = b + 1;
        }
        // 2-way branch outside the inner loop
        if step > 15 {
            a = a + k[3];
        } else {
            a = a + 5;
            result = result - 1;
        }
        // Reset inner loop counter (tests back-edge PHI updating for 'b')
        b = 0;
    }
    return a + result;
}


