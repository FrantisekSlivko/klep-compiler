
generic enum Option<T> {
    None,
    Some(T)
}

generic struct Node<T> {
    T value;
    Option<Box<Node<T>>> next;
}

// generic struct Node2<T> {
//     T value;
//     Option<Node2<T>> next;
// }

// Node2<Int32> n() {
//     return new Node2 { value = 1, next = new Option::None };
// }

Void overload_test() {}
Void overload_test(Int32 a) {}

Void node_test() {
    Node<Int32> n1 = new Node { value = 10, next = new Option::None };
    Node<Int32> n2 = new Node { value = 11, next = new Option::Some(box(n1))};

    // no arg
    overload_test();

    // literal
    overload_test(1);

    // passing exact
    Int32 exact = 1;
    overload_test(exact);

    // passing smaller int type
    Int16 lower_bits = 1;
    overload_test(lower_bits);

    // passing reference
    Ref<Int32> i_ref = exact;
    overload_test(i_ref);

    // passing string literal = Slice<Char> -> generic with Slice<T>
    overload_test("Hi");

    // passing list -> generic with T
    List<Int32> l = [1,2];
    overload_test(l);

    // passing box -> Box<T>
    Box<Int32> b1 = box(exact);
    overload_test(b1);

    // passing box of box -> Box<Box<T>>
    Box<Box<Int32>> b2 = box(b1);
    overload_test(b2);
}

generic void overload_test<T>(T a) {
    Float32 this_is_generic_with_just_t = 0.0;
}



generic void overload_test<T>(Slice<T> a) {
    Int this_is_generic_with_slice_t = 0;
}

generic void overload_test<T>(Box<T> a) {
    Uint32 v = 1;
}
generic void overload_test<T>(Box<Box<T>> a) {
    Uint64 v = 1;
}