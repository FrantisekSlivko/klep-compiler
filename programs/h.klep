enum Position {
    D1(Int32),
    D2(Int32, Int32),
    D3(Int32, Int32, Int32),
    None
}

Void pos_match() {
    Position p1 = new Position::D1(4);
    Position p2 = new Position::D2(4, 5);
    Position p3 = new Position::D3(4, 5, 8);
    Position p4 = new Position::None;

    List<Position> poss = [p1, p2, p3, p4];
    Uint i = 0;
    while i < poss.len {
        match poss[i] {
            Position::D2(x, y) => {
                Int l = x + y;
                print_str("D2");
            }
            Position::D1(x) => {
                Int l = x + 4;
                print_str("D1");
            }
            Position::D3(x, y, z) => {
                Int l = x + y - z;
                print_str("D3");
            }
            Position::None => {
                print_str("None");
            }
        }
        i += 1;
    }
}

