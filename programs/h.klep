Int main() {
    Int8 x = 0;
    match x {
        0 => {
            print_str("zero");
            x += 1;
        }
        1 => {
            print_str("one");
            x += 2;
        }
        2 => {
            print_str("two");
            x += 2;
        }
        n => {
            Int8 k = n + 4;
            print_str("any");
            if k < 20 {
                print_str("any1");
                x += k;
            } else {
                print_str("any2");
                x += k + 1;
            }
        }
    }
    return x;
}

