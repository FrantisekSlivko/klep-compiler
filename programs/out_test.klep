Int main() {
    Slice<Char> str = "Hello World!\n";
    print(str);
    puts(str[0]);
    List<Char> str2 = "abc\n";
    str2[2] = 'd';
    print(str2);
    print(124);
    print("\n");
    return 0;
}

Void print(Slice<Char> str) {
    Uint c_index = 0;
    while c_index < str.len {
        putc(str[c_index]);
        c_index += 1;
    }
}

Void print(List<Char> str) {
    Uint c_index = 0;
    while c_index < str.len {
        putc(str[c_index]);
        c_index += 1;
    }
}

Void print(Int64 i) {
    Array<Char, 4> c = "%li\0";
    printf_int(c[0], i);
}




extern void printf(char* s, int64_t v)
    into
    Void printf_int(Ref<Char> s, Int64 v);

extern void puts(char* c)
    into
    Void puts(Ref<Char> c);

extern void putchar(char c)
    into
    Void putc(Char c);
