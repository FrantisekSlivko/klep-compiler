Int main() {
    Int v1 = 5;
    Int v2 = v1 + 3;
    Int res = add(v1, v2);

    A s1 = new A { v1=1, v2=2 };
    Ref<A> s2 = s1;
    Int res1 = add(s1);
    // Int res2 = add(s2, 0);

    Slice<Char> str = "Hello World!\n";
    // print_string(str);

    Int i = 0;
    while i < 10 {
        i += 1;
    }
    exit(cast<Uint8>(i));
    return 0;
}

