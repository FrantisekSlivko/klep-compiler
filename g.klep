generic enum Option<T> {
    Some(T),
    None
}

Void generic_enum_match_test() {
    Option<Int> v = new Option::Some(4);

    match v {
        Option::Some(1) => {print_str("one");}
        Option::Some(4) => {print_str("four");}
        Option::Some(n) => {
            if n > 10 {
                print_str("big number");
            } else {
                print_str("small number");
            }
        }
        Option::None => {
            print_str("empty?");
        }
    }
}

generic T add<T>(T a, T b) {
    return a + b;
}

Int add_int32(Int a, Int b) {
    return a + b;
}

Void generic_usage(Int a) {
    Int b = add(1, 3);
    Int64 c = b.add(3);
    c.add(5);
}


generic T unwrap<T>(Option<T> item) {
    match item {
        Option::Some(n) => {
            return n;
        }
        Option::None => {
            print_str("unwrap failed\n");
            exit(1);
        }
    }
}